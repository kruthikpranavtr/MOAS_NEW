{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered candidate or employer profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "role": { "type": "string", "enum": ["Candidate", "Employer", "jobseeker", "employer"] },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "location": { "type": "string", "maxLength": 150 },
        "quote": { "type": "string", "maxLength": 300 },
        "aboutMe": { "type": "string", "maxLength": 3000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Job": {
      "title": "Job",
      "description": "Verified job opening on MOAS",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "company": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 150 },
        "type": { "type": "string", "maxLength": 50 },
        "experience": { "type": "string", "maxLength": 50 },
        "salary": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 10000 },
        "department": { "type": "string", "maxLength": 80 },
        "isVerified": { "type": "boolean" },
        "postedDate": { "type": "string" }
      },
      "required": ["id", "title", "company", "location", "salary"]
    },
    "Application": {
      "title": "Application",
      "description": "Candidate application to a job position",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "jobId": { "type": "string", "maxLength": 128 },
        "jobTitle": { "type": "string", "maxLength": 150 },
        "company": { "type": "string", "maxLength": 100 },
        "candidateId": { "type": "string", "maxLength": 128 },
        "candidateName": { "type": "string", "maxLength": 100 },
        "candidateEmail": { "type": "string", "maxLength": 120 },
        "appliedDate": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["Applied", "Under Review", "Shortlisted", "Interview Scheduled", "Rejected", "Offered"] },
        "stage": { "type": "string", "maxLength": 60 },
        "matchScore": { "type": "number" },
        "resumeName": { "type": "string", "maxLength": 150 }
      },
      "required": ["id", "jobId", "candidateId", "status"]
    },
    "Resume": {
      "title": "Resume",
      "description": "Candidate CV or resume document metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "size": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "type": { "type": "string", "maxLength": 20 },
        "isPrimary": { "type": "boolean" }
      },
      "required": ["id", "userId", "name", "type"]
    },
    "Company": {
      "title": "Company",
      "description": "Tech employer and enterprise hiring profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "industry": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 150 },
        "openJobsCount": { "type": "number" },
        "rating": { "type": "number" },
        "verified": { "type": "boolean" }
      },
      "required": ["id", "name", "industry"]
    },
    "SavedJob": {
      "title": "SavedJob",
      "description": "Candidate bookmarked job posting",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "jobId": { "type": "string", "maxLength": 128 },
        "savedDate": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "jobId"]
    },
    "JobAlert": {
      "title": "JobAlert",
      "description": "Automated career alerts criteria",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "keyword": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 100 },
        "frequency": { "type": "string", "enum": ["Daily", "Weekly", "Instant"] },
        "active": { "type": "boolean" }
      },
      "required": ["id", "userId", "keyword"]
    },
    "CompanyRating": {
      "title": "CompanyRating",
      "description": "User reviews and star ratings for companies",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "companyName": { "type": "string", "maxLength": 150 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userRole": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "cultureRating": { "type": "number" },
        "workLifeRating": { "type": "number" },
        "growthRating": { "type": "number" },
        "compensationRating": { "type": "number" },
        "reviewTitle": { "type": "string", "maxLength": 200 },
        "reviewText": { "type": "string", "maxLength": 3000 },
        "pros": { "type": "string", "maxLength": 1000 },
        "cons": { "type": "string", "maxLength": 1000 },
        "recommendToFriend": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "companyName", "userId", "rating"]
    },
    "ProfileView": {
      "title": "ProfileView",
      "description": "Live verified profile view event from recruiters and employers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "viewerType": { "type": "string", "enum": ["Recruiter", "Hiring Manager", "Employer", "Platform Visitor"] },
        "viewerName": { "type": "string", "maxLength": 100 },
        "viewerCompany": { "type": "string", "maxLength": 100 },
        "viewerRole": { "type": "string", "maxLength": 100 },
        "source": { "type": "string", "maxLength": 200 },
        "viewedAt": { "type": "string" },
        "durationSeconds": { "type": "number" }
      },
      "required": ["id", "userId", "viewerName", "viewedAt"]
    },
    "OTPDispatch": {
      "title": "OTPDispatch",
      "description": "Live OTP verification dispatch sent to mobile phone or Gmail",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 10 },
        "channel": { "type": "string", "enum": ["sms", "email", "both"] },
        "destination": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["sent", "delivered", "verified", "expired"] },
        "expiresAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "verifiedAt": { "type": "string" }
      },
      "required": ["id", "code", "channel", "createdAt", "expiresAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User candidate and employer profiles"
    },
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Job listings published on MOAS"
    },
    "/applications/{applicationId}": {
      "schema": "Application",
      "description": "Submitted job applications"
    },
    "/resumes/{resumeId}": {
      "schema": "Resume",
      "description": "Uploaded resume records permanently tied to candidate IDs"
    },
    "/companies/{companyId}": {
      "schema": "Company",
      "description": "Profiles of verified hiring companies"
    },
    "/savedJobs/{savedJobId}": {
      "schema": "SavedJob",
      "description": "Bookmarked job positions"
    },
    "/jobAlerts/{alertId}": {
      "schema": "JobAlert",
      "description": "Configured job alert subscriptions"
    },
    "/companyRatings/{ratingId}": {
      "schema": "CompanyRating",
      "description": "Candidate and employee submitted company ratings and reviews"
    },
    "/profileViews/{viewId}": {
      "schema": "ProfileView",
      "description": "Live recruiter and employer profile view audit events"
    },
    "/otps/{otpId}": {
      "schema": "OTPDispatch",
      "description": "Live OTP verification records sent to mobile phone and Gmail"
    }
  }
}
