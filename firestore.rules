rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'kruthikpranav02@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Validation blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role']) &&
        data.id is string && isValidId(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 120 &&
        (data.role in ['Candidate', 'Employer', 'jobseeker', 'employer']);
    }

    function isValidJob(data) {
      return data.keys().hasAll(['id', 'title', 'company', 'location', 'salary']) &&
        data.id is string && isValidId(data.id) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
        data.company is string && data.company.size() > 0 && data.company.size() <= 100 &&
        data.location is string && data.location.size() <= 150 &&
        data.salary is string && data.salary.size() <= 80;
    }

    function isValidApplication(data) {
      return data.keys().hasAll(['id', 'jobId', 'candidateId', 'status']) &&
        data.id is string && isValidId(data.id) &&
        data.jobId is string && isValidId(data.jobId) &&
        data.candidateId is string && isValidId(data.candidateId) &&
        (data.status in ['Applied', 'Under Review', 'Shortlisted', 'Interview Scheduled', 'Rejected', 'Offered']);
    }

    function isValidResume(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'type']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && isValidId(data.userId) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
        data.type is string && data.type.size() <= 20;
    }

    // 1. Users Collection - Require authentication and resource ownership
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming());
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 2. Jobs Collection - Public read, Employer/Admin write
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.auth.token.role in ['Employer', 'employer'] || isAdmin()) && isValidJob(incoming());
      allow update: if isSignedIn() && (request.auth.token.role in ['Employer', 'employer'] || isAdmin()) && isValidJob(incoming());
      allow delete: if isSignedIn() && (request.auth.token.role in ['Employer', 'employer'] || isAdmin());
    }

    // 3. Applications Collection - Candidate or Employer/Admin access
    match /applications/{applicationId} {
      allow read: if isSignedIn() && (resource == null || resource.data.candidateId == request.auth.uid || request.auth.token.role in ['Employer', 'employer'] || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == incoming().candidateId && isValidApplication(incoming());
      allow update: if isSignedIn() && (request.auth.token.role in ['Employer', 'employer'] || resource.data.candidateId == request.auth.uid || isAdmin()) && isValidApplication(incoming());
      allow delete: if isSignedIn() && (resource.data.candidateId == request.auth.uid || isAdmin());
    }

    // 4. Resumes Collection - Owner or Recruiter/Admin access
    match /resumes/{resumeId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || request.auth.token.role in ['Employer', 'employer'] || isAdmin());
      allow create, update: if isSignedIn() && request.auth.uid == incoming().userId && isValidResume(incoming());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 5. Companies Collection - Public read, Employer/Admin write
    match /companies/{companyId} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.token.role in ['Employer', 'employer'] || isAdmin());
    }

    // 6. Saved Jobs Collection - Candidate ownership
    match /savedJobs/{savedJobId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (incoming().userId == request.auth.uid || isAdmin());
    }

    // 7. Job Alerts Collection - Candidate ownership
    match /jobAlerts/{alertId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (incoming().userId == request.auth.uid || isAdmin());
    }

    // 8. Company Ratings & Reviews Collection - Public read, Owner write
    match /companyRatings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 9. Profile Views Collection - Recruiter/Employer impressions
    match /profileViews/{viewId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isSignedIn();
    }

    // 10. OTP Dispatches - Strictly internal backend operations, deny direct client access
    match /otps/{otpId} {
      allow read, write: if false;
    }
  }
}
