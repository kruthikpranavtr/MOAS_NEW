rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'kruthikpranav02@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Validation blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role']) &&
        data.id is string && isValidId(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 120 &&
        (data.role in ['Candidate', 'Employer', 'jobseeker', 'employer']);
    }

    function isValidJob(data) {
      return data.keys().hasAll(['id', 'title', 'company', 'location', 'salary']) &&
        data.id is string && isValidId(data.id) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
        data.company is string && data.company.size() > 0 && data.company.size() <= 100 &&
        data.location is string && data.location.size() <= 150 &&
        data.salary is string && data.salary.size() <= 80;
    }

    function isValidApplication(data) {
      return data.keys().hasAll(['id', 'jobId', 'candidateId', 'status']) &&
        data.id is string && isValidId(data.id) &&
        data.jobId is string && isValidId(data.jobId) &&
        data.candidateId is string && isValidId(data.candidateId) &&
        (data.status in ['Applied', 'Under Review', 'Shortlisted', 'Interview Scheduled', 'Rejected', 'Offered']);
    }

    function isValidResume(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'type']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && isValidId(data.userId) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
        data.type is string && data.type.size() <= 20;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isValidUser(incoming());
      allow delete: if isValidId(userId);
    }

    // 2. Jobs Collection
    match /jobs/{jobId} {
      allow read: if true;
      allow create, update: if isValidId(jobId) && isValidJob(incoming());
      allow delete: if isValidId(jobId);
    }

    // 3. Applications Collection
    match /applications/{applicationId} {
      allow read: if true;
      allow create, update: if isValidId(applicationId) && isValidApplication(incoming());
      allow delete: if isValidId(applicationId);
    }

    // 4. Resumes Collection
    match /resumes/{resumeId} {
      allow read: if true;
      allow create, update: if isValidId(resumeId) && isValidResume(incoming());
      allow delete: if isValidId(resumeId);
    }

    // 5. Companies Collection
    match /companies/{companyId} {
      allow read: if true;
      allow write: if isValidId(companyId);
    }

    // 6. Saved Jobs Collection
    match /savedJobs/{savedJobId} {
      allow read: if true;
      allow write: if isValidId(savedJobId);
    }

    // 7. Job Alerts Collection
    match /jobAlerts/{alertId} {
      allow read: if true;
      allow write: if isValidId(alertId);
    }

    // 8. Company Ratings & Reviews Collection
    match /companyRatings/{ratingId} {
      allow read: if true;
      allow write: if isValidId(ratingId);
    }

    // 9. Profile Views Collection (Live Verified Recruiter & Employer Impressions)
    match /profileViews/{viewId} {
      allow read: if true;
      allow write: if isValidId(viewId);
    }

    // 10. OTP Dispatches (Mobile Phone & Gmail Verification Codes)
    match /otps/{otpId} {
      allow read: if true;
      allow write: if isValidId(otpId);
    }
  }
}
