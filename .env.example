# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GMAIL_USER: Optional Gmail address for sending real OTP verification emails via Gmail SMTP.
GMAIL_USER=

# GMAIL_APP_PASSWORD: Optional 16-character Google App Password for the sender Gmail account.
GMAIL_APP_PASSWORD=

# TWILIO_ACCOUNT_SID: Optional Twilio Account SID for sending real SMS OTPs to mobile phones.
TWILIO_ACCOUNT_SID=

# TWILIO_AUTH_TOKEN: Optional Twilio Auth Token for SMS gateway.
TWILIO_AUTH_TOKEN=

# TWILIO_PHONE_NUMBER: Optional Twilio sender number (e.g., +1234567890).
TWILIO_PHONE_NUMBER=

# TEXTBEE_API_KEY: API key from textbee.dev dashboard for SMS gateway.
TEXTBEE_API_KEY=

# TEXTBEE_DEVICE_ID: Device ID of the registered Android phone on textbee.dev.
TEXTBEE_DEVICE_ID=

# ==========================================
# POSTGRESQL DATABASE CONFIGURATION (Phase 4)
# ==========================================
# Primary PostgreSQL connection string (defaults to local development PostgreSQL instance)
DATABASE_URL="postgresql://mindaura:mindaura_dev_pw@127.0.0.1:5432/mindaura?options=-c%20search_path%3Dmoas,public"

# Test PostgreSQL connection string (used during automated integration tests)
DATABASE_TEST_URL="postgresql://mindaura:mindaura_dev_pw@127.0.0.1:5432/mindaura_test?options=-c%20search_path%3Dmoas,public"

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
DATABASE_SSL=false
COOKIE_SECURE=false
